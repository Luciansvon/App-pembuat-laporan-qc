+    private void writeReport(File report, Uri destination, int grantFlags, boolean persistable) {
+        new Thread(() -> {
+            boolean retained = false;
+            try {
+                if (persistable) {
+                    try {
+                        getContentResolver().takePersistableUriPermission(destination, grantFlags);
+                        retained = true;
+                    } catch (SecurityException error) {
+                        Log.w(TAG, "Provider did not retain the document grant", error);
+                    }
+                }
+                try (InputStream source = new FileInputStream(report);
+                        OutputStream target = getContentResolver().openOutputStream(destination, "w")) {
+                    if (target == null) throw new IOException("No output stream");
+                    byte[] buffer = new byte[65536];
+                    int count;
+                    while ((count = source.read(buffer)) != -1) target.write(buffer, 0, count);
+                }
+                runOnUiThread(() -> Toast.makeText(this, "DOCX tersimpan", Toast.LENGTH_LONG).show());
+            } catch (IOException | SecurityException error) {
+                Log.e(TAG, "Cannot save DOCX", error);
+                runOnUiThread(() -> Toast.makeText(this,
+                        "Gagal menyimpan DOCX. Coba lokasi lain.", Toast.LENGTH_LONG).show());
+            } finally {
+                report.delete();
+                if (retained) {
+                    try {
+                        getContentResolver().releasePersistableUriPermission(destination, grantFlags);
+                    } catch (SecurityException error) {
+                        Log.w(TAG, "Document grant was already released", error);
+                    }
+                }
+                runOnUiThread(() -> reportSaving = false);
+            }
+        }, "InspectraReportSave").start();
+    }
+
+    private void saveReport(String id) {
+        try {
+            java.util.UUID.fromString(id);
+        } catch (IllegalArgumentException error) {
+            Toast.makeText(this, "ID inspeksi tidak valid", Toast.LENGTH_LONG).show();
+            return;
+        }
+        if (reportSaving) return;
+        reportSaving = true;
+        new Thread(() -> {
+            HttpURLConnection connection = null;
+            File report = new File(getCacheDir(), "Inspectra-" + id + ".docx");
+            try {
+                URL url = new URL("http://127.0.0.1:5000/api/inspections/" + id + "/report/docx");
+                connection = (HttpURLConnection) url.openConnection();
+                connection.setRequestMethod("POST");
+                connection.setConnectTimeout(5000);
+                connection.setReadTimeout(120000);
+                if (connection.getResponseCode() != 200) {
+                    throw new IOException("HTTP " + connection.getResponseCode());
+                }
+                try (InputStream source = connection.getInputStream();
+                        OutputStream target = new FileOutputStream(report)) {
+                    byte[] buffer = new byte[65536];
+                    int count;
+                    long total = 0;
+                    while ((count = source.read(buffer)) != -1) {
+                        total += count;
+                        if (total > 100_000_000) throw new IOException("DOCX too large");
+                        target.write(buffer, 0, count);
+                    }
+                }
+                runOnUiThread(() -> {
+                    pendingReportFile = report;
+                    Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+                    intent.addCategory(Intent.CATEGORY_OPENABLE);
+                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION
+                            | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                            | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+                    intent.setType("application/vnd.openxmlformats-officedocument.wordprocessingml.document");
+                    intent.putExtra(Intent.EXTRA_TITLE, report.getName());
+                    try {
+                        startActivityForResult(intent, REQUEST_SAVE_REPORT);
+                    } catch (ActivityNotFoundException error) {
+                        report.delete();
+                        pendingReportFile = null;
+                        reportSaving = false;
+                        Toast.makeText(this, "Pemilih lokasi simpan tidak tersedia", Toast.LENGTH_LONG).show();
+                    }
+                });
+            } catch (IOException error) {
+                Log.e(TAG, "Cannot generate DOCX", error);
+                report.delete();
+                runOnUiThread(() -> {
+                    reportSaving = false;
+                    Toast.makeText(this, "Gagal membuat DOCX: " + error.getMessage(), Toast.LENGTH_LONG).show();
+                });
+            } finally {
+                if (connection != null) connection.disconnect();
+            }
+        }, "InspectraReportExport").start();
+    }
